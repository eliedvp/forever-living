# Port d'écoute de l'API
PORT=5001

# Chaîne de connexion MongoDB
MONGO_URI=mongodb://localhost:27017/forever-living

# Secret de signature des JWT (obligatoire) : utiliser une longue valeur aléatoire,
# par exemple : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=remplacer_par_une_valeur_aleatoire_longue

# Origines autorisées par CORS, séparées par des virgules (optionnel).
# Si vide, toutes les origines sont acceptées (pratique en développement).
CORS_ORIGIN=http://localhost:3000
